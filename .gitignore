# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*.plan

# Crash log
crash.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Dependency lock file
# Keep this file if you're working in a team to ensure consistent provider versions.
# Uncomment the next line only if you don't want to track it.
# .terraform.lock.hcl

# Sensitive files
*.pem
*.key
*.p12

# IDE files
.vscode/
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
.vs/
